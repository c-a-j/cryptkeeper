{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "BUILD_TESTING": false,
        "CK_ENABLE_SANITIZERS": false,
        "CK_ENABLE_DEBUG_LOGS": false,
        "CK_ENABLE_CLANG_TIDY": false
      }
    },
    {
      "name": "debug",
      "displayName": "Debug build",
      "inherits": ["base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CK_ENABLE_SANITIZERS": true,
        "CK_ENABLE_DEBUG_LOGS": true
      }
    },
    {
      "name": "tidy",
      "displayName": "Debug build with clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "CK_ENABLE_CLANG_TIDY": true
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "tidy", "configurePreset": "tidy" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
